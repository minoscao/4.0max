# Dependencies and local package cache
node_modules/
.pnpm-store/

# Generated builds and temporary outputs
dist/
_docx_work/

# Cloudflare Workers deploys the committed production bundle. Keeping this
# directory in Git makes the deployment independent of dashboard build settings.
!admin-dashboard-tester/dist/
admin-dashboard-tester/dist/*
!admin-dashboard-tester/dist/client/
!admin-dashboard-tester/dist/client/**

# Use pnpm-lock.yaml as the single lockfile
admin-dashboard-tester/package-lock.json

# Local environment and logs
.env
.env.*
!.env.example
*.log
~$*.docx

# OS files
.DS_Store
Thumbs.db
